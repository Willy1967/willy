FUNCTION_BLOCK "FB_Sensor_Trim"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    IncrementCmd : Bool;
    DecrementCmd : Bool;
    StepSize     : Real := 0.1;
    ResetCmd     : Bool;
END_VAR

VAR_OUTPUT
    TrimOffset   : Real;
END_VAR

VAR
    IncEdge : R_TRIG;
    DecEdge : R_TRIG;
END_VAR

BEGIN
    #IncEdge(CLK := #IncrementCmd);
    #DecEdge(CLK := #DecrementCmd);

    IF #ResetCmd THEN
        #TrimOffset := 0.0;
    ELSIF #IncEdge.Q THEN
        #TrimOffset := #TrimOffset + #StepSize;
    ELSIF #DecEdge.Q THEN
        #TrimOffset := #TrimOffset - #StepSize;
    END_IF;
END_FUNCTION_BLOCK
